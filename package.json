{
  "name": "akash-negi-markdown-editor",
  "version": "0.1.0",
  "description": "A dependency-free React + TypeScript markdown editor with live preview built by Akash Negi.",
  "keywords": [
    "markdown",
    "markdown-editor",
    "editor",
    "react",
    "typescript",
    "wysiwyg",
    "live-preview",
    "syntax-highlighting"
  ],
  "license": "MIT",
  "author": "Akash Negi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AKASHNEGI-github/Markdown-Editor-React.ts.git"
  },
  "bugs": {
    "url": "https://github.com/AKASHNEGI-github/Markdown-Editor-React.ts/issues"
  },
  "homepage": "https://github.com/AKASHNEGI-github/Markdown-Editor-React.ts#readme",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:demo",
    "build:demo": "vite build",
    "build:lib": "tsc -p tsconfig.build.json && node scripts/fix-dist-extensions.mjs && node scripts/copy-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build:lib"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
